{
  "manifest_version": 3,
  "name": "VocabShift - Tra & lưu từ",
  "version": "1.0.3",
  "description": "Bôi đen từ rồi nhấn Shift để xem nghĩa tiếng Việt, phát âm và lưu từ vào máy.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.datamuse.com/*",
    "https://oemuptgkxjddzpljdnrg.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["migrate.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["review.html", "review.css", "review.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Từ đã lưu",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
